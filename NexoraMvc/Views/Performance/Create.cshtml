@model EvaluationViewModel
@using NexoraEmployeePayroll.Models
@{ViewData["Title"]="Give Performance Rating"; var employees=ViewBag.Employees as IEnumerable<Employee> ?? Array.Empty<Employee>(); var isAdmin=User.IsInRole("Admin");}
<div class="card"><div class="card-header"><h3>Performance Evaluation</h3></div><div class="card-body"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="form-group"><label asp-for="EmployeeId">@(isAdmin ? "HR / Manager / Payroll Officer" : "Employee / Staff")</label><select asp-for="EmployeeId" class="form-control"><option value="">-- Select --</option>@foreach(var e in employees){<option value="@e.EmployeeId">EMP-@e.EmployeeId.ToString("000") — @e.Name — @e.Designation</option>}</select></div><div class="form-group"><label asp-for="Score">Rating (0-5)</label><input asp-for="Score" type="number" min="0" max="5" step="0.1" class="form-control"/></div><div class="form-group" style="grid-column:1/-1"><label asp-for="Remarks">Remarks</label><textarea asp-for="Remarks" class="form-control"></textarea></div></div><button class="btn btn-primary">Save Rating</button></form></div></div>
