@model HRReportViewModel
@{ViewData["Title"]="HR Reports";}
<div class="card"><div class="card-header"><h3>Onboarded Employees — @Model.Month.ToString("MMMM yyyy")</h3><p class="muted">Employees whose joining date falls in the current month.</p></div><div class="card-body table-responsive"><table><thead><tr><th>Employee ID</th><th>Name</th><th>Department</th><th>Designation</th><th>Date Joined</th></tr></thead><tbody>@foreach(var e in Model.OnboardedEmployees){<tr><td>EMP-@e.EmployeeId.ToString("000")</td><td>@e.Name</td><td>@e.Department?.DepartmentName</td><td>@e.Designation</td><td>@e.DateOfJoining.ToString("dd-MM-yyyy")</td></tr>}@if(!Model.OnboardedEmployees.Any()){<tr><td colspan="5" class="muted">No employees onboarded this month.</td></tr>}</tbody></table></div></div>
