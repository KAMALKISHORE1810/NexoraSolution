@model PayrollHistoryViewModel
@{ViewData["Title"]="Payroll Payment History";}
<div class="card"><div class="card-header"><h3>Payments Completed — @Model.Month</h3><p class="muted">History of salaries actually marked PAID this month.</p></div><div class="card-body table-responsive"><table><thead><tr><th>Payroll</th><th>Employee</th><th>Designation</th><th>Basic</th><th>Deductions</th><th>Net Paid</th><th>Paid Date</th><th>Status</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td>PAY-@p.PayrollId</td><td>@p.Employee?.Name</td><td>@p.Employee?.Designation</td><td>₹@p.BasicSalary.ToString("N0")</td><td>₹@p.Deductions.ToString("N0")</td><td><strong>₹@p.NetSalary.ToString("N0")</strong></td><td>@(p.PaymentDate?.ToString("dd-MM-yyyy HH:mm") ?? "Not recorded")</td><td><span class="badge badge-paid">PAID</span></td></tr>}</tbody></table></div></div>
