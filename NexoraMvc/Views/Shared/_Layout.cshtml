<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Nexora Technologies | Enterprise HRMS & Payroll</title><link rel="stylesheet" href="~/css/site.css"/></head>
<body>
<aside><div class="brand-header"><div class="logo-icon">N</div><div class="brand-text"><h1>NEXORA TECH</h1><span>India Tech Ops</span></div></div><ul class="nav-menu"><div class="nav-section-title">Workspace</div><li><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
@if(User.IsInRole("HROfficer")){<div class="nav-section-title">Human Resources</div><li><a class="nav-link" asp-controller="Employee" asp-action="Profile">My Profile</a></li><li><a class="nav-link" asp-controller="Employee" asp-action="Index">Employee Directory</a></li><li><a class="nav-link" asp-controller="Employee" asp-action="Create">Onboard Employee</a></li><li><a class="nav-link" asp-controller="Leave" asp-action="Index">My Leave</a></li><li><a class="nav-link" asp-controller="Performance" asp-action="Index">Performance & Appraisal</a></li><li><a class="nav-link" asp-controller="Employee" asp-action="OffboardingRequests">Offboarding Approvals</a></li><li><a class="nav-link" asp-controller="Report" asp-action="HRReports">HR Reports</a></li>}
@if(User.IsInRole("PayrollOfficer")){<div class="nav-section-title">Payroll</div><li><a class="nav-link" asp-controller="Employee" asp-action="Profile">My Profile</a></li><li><a class="nav-link" asp-controller="Payroll" asp-action="Index">Salary & Disbursement</a></li><li><a class="nav-link" asp-controller="Employee" asp-action="Index">Employee Directory & Payroll</a></li><li><a class="nav-link" asp-controller="Report" asp-action="PayrollHistory">Payroll Reports</a></li><li><a class="nav-link" asp-controller="Leave" asp-action="Index">My Leave &amp; History</a></li>}
@if(User.IsInRole("Manager")){<div class="nav-section-title">Management</div><li><a class="nav-link" asp-controller="Employee" asp-action="Profile">My Profile</a></li><li><a class="nav-link" asp-controller="Employee" asp-action="Index">Team Employees</a></li><li><a class="nav-link" asp-controller="Attendance" asp-action="Index">Team Attendance</a></li><li><a class="nav-link" asp-controller="Leave" asp-action="Index">Leave Approvals</a></li><li><a class="nav-link" asp-controller="Performance" asp-action="Index">Performance & Appraisal</a></li>}
@if(User.IsInRole("Admin")){<div class="nav-section-title">Administration</div><li><a class="nav-link" asp-controller="Employee" asp-action="Index">Employee Directory</a></li><li><a class="nav-link" asp-controller="Employee" asp-action="CreateOfficer">Add Manager / HR / Payroll</a></li><li><a class="nav-link" asp-controller="Employee" asp-action="OnboardingRequests">Employee Onboarding Approvals</a></li><li><a class="nav-link" asp-controller="Leave" asp-action="Index">Staff Leave Approvals</a></li><li><a class="nav-link" asp-controller="Employee" asp-action="OffboardingRequests">Offboarding Approvals</a></li><li><a class="nav-link" asp-controller="Performance" asp-action="Index">Performance & Appraisal</a></li>}
@if(User.IsInRole("Employee")){<div class="nav-section-title">My Workspace</div><li><a class="nav-link" asp-controller="Employee" asp-action="Profile">My Profile</a></li><li><a class="nav-link" asp-controller="Attendance" asp-action="Index">My Attendance</a></li><li><a class="nav-link" asp-controller="Leave" asp-action="Index">My Leave</a></li><li><a class="nav-link" asp-controller="Payroll" asp-action="Index">My Payroll</a></li>}
</ul></aside>
<main><header class="topbar"><div class="header-title-wrap"><h2>@ViewData["Title"]</h2><div class="role-notice">Signed in as <strong>@User.FindFirst("DisplayName")?.Value</strong> · @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div></div><div class="user-controls"><div class="user-profile-badge"><div class="avatar">@((User.FindFirst("DisplayName")?.Value ?? "N").Length >= 2 ? User.FindFirst("DisplayName")!.Value[..2].ToUpper() : "N")</div><div><div class="user-name">@User.FindFirst("DisplayName")?.Value</div><div class="user-title">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div></div></div><a class="btn btn-secondary btn-sm" asp-controller="Account" asp-action="ChangePassword">Change Password</a><a class="btn btn-logout" asp-controller="Account" asp-action="Logout">Sign Out</a></div></header>
<div class="workspace">
@foreach(var key in new[]{"Success","Error","Info"}){if(TempData[key] is string message){<div class="toast @(key=="Success"?"toast-success":key=="Error"?"toast-error":"toast-info")" role="alert"><span>@message</span><button type="button" onclick="this.parentElement.remove()">×</button></div>}}
@RenderBody()</div></main><script src="~/js/site.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
