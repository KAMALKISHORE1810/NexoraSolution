@model IEnumerable<Department>
@{ViewData["Title"]="Department Management";}<div class="card"><div class="card-header"><h3>Departments</h3></div><div class="card-body"><form asp-action="Create" method="post" class="form-grid"><div class="form-group"><label>Department Name</label><input name="departmentName" required maxlength="100"/></div><button class="btn btn-primary">Add Department</button></form><div class="table-responsive"><table><thead><tr><th>ID</th><th>Department</th><th>Employees</th></tr></thead><tbody>@foreach(var d in Model){<tr><td>@d.DepartmentId</td><td>@d.DepartmentName</td><td>@d.Employees.Count</td></tr>}</tbody></table></div></div></div>
