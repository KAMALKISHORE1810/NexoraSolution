@model LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>Nexora Technologies Login</title>
    <link rel="stylesheet" href="~/css/site.css"/>
</head>
<body class="login-page">
<div class="login-overlay">
    <div class="login-card">
        <div class="login-header">
            <div class="logo-icon" style="margin:0 auto 12px">N</div>
            <h2>NEXORA TECHNOLOGIES</h2>
            <p>Enterprise HRMS &amp; Payroll Suite</p>
        </div>

        <form id="loginForm" asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="login-error-text" role="alert"></div>

            <div class="form-group">
                <label asp-for="Username">Enterprise Username / ID</label>
                <input asp-for="Username" class="form-control" placeholder="Enter username" autocomplete="username" maxlength="15" autofocus/>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <div class="password-field">
                    <input asp-for="Password" id="loginPassword" class="form-control" type="password" placeholder="Enter password" autocomplete="current-password" maxlength="15"/>
                    <button type="button" id="togglePassword" class="password-toggle" aria-label="Show password" aria-pressed="false" title="Show password">
                        <svg id="eyeHidden" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 3l18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M10.9 6.2C11.26 6.08 11.63 6 12 6c6.2 0 9.8 6 9.8 6a17.7 17.7 0 0 1-3.05 3.43M6.55 6.7C4.02 8.25 2.2 12 2.2 12S5.8 18 12 18c1.32 0 2.5-.28 3.53-.69" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                        <svg id="eyeVisible" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" style="display:none"><path d="M2.2 12s3.6-6 9.8-6 9.8 6 9.8 6-3.6 6-9.8 6-9.8-6-9.8-6Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;padding:10px;margin-top:8px">Authenticate &amp; Enter</button>
        </form>

        <div style="margin-top:14px;text-align:center"><a class="btn btn-secondary btn-sm" href="/Account/FirstLogin">New User / First Login</a></div>
        <div class="quick-creds">
            <strong>Development Accounts</strong>
            <div class="cred-grid">
                <span>Admin — Brinda: admin / admin123</span>
                <span>HR — Kamal Kishore: hr / hr123</span>
                <span>Payroll — Aditya: payroll / pay123</span>
                <span>Manager — Divya: manager / mgr123</span>
                <span>Employee — Kalyan: emp101 / emp123</span>
            </div>
            <p class="muted" style="margin-top:8px">Demo credentials are for local development only.</p>
        </div>
    </div>
</div>

<script>
(() => {
    const password = document.getElementById('loginPassword');
    const toggle = document.getElementById('togglePassword');
    const hiddenEye = document.getElementById('eyeHidden');
    const visibleEye = document.getElementById('eyeVisible');
    if (!password || !toggle) return;

    const syncEyeState = (showPassword) => {
        password.type = showPassword ? 'text' : 'password';
        if (hiddenEye) hiddenEye.style.display = showPassword ? 'none' : 'block';
        if (visibleEye) visibleEye.style.display = showPassword ? 'block' : 'none';
        const nextLabel = showPassword ? 'Hide password' : 'Show password';
        toggle.setAttribute('aria-label', nextLabel);
        toggle.setAttribute('title', nextLabel);
        toggle.setAttribute('aria-pressed', String(showPassword));
    };

    toggle.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        syncEyeState(password.type === 'password');
        password.focus();
    });

    syncEyeState(false);
})();
</script>
</body>
</html>
