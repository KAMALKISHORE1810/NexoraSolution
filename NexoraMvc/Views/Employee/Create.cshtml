@model EmployeeCreateViewModel
@{ ViewData["Title"]="Onboard New Employee"; }
<div class="card"><div class="card-header"><h3>Employee Onboarding Request</h3><p class="muted">Your request will be sent to Admin for approval. The employee account and login credentials are created only after Admin approval.  Temporary password = first four letters of name + DOB (DDMMYYYY).</p></div><div class="card-body"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div><div class="form-grid">
<div class="form-group"><label asp-for="Name">Full Name</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name"></span></div>
<div class="form-group"><label asp-for="DateOfBirth">Date of Birth</label><input asp-for="DateOfBirth" type="date" class="form-control"/><span asp-validation-for="DateOfBirth"></span></div>
<div class="form-group"><label asp-for="Designation"></label><select asp-for="Designation" class="form-control"><option value="">-- Select Designation --</option>@foreach(var d in (List<string>)ViewBag.Designations){<option value="@d">@d</option>}</select></div>
<div class="form-group"><label asp-for="DepartmentId">Department</label><select asp-for="DepartmentId" class="form-control"><option value="">-- Select Department --</option>@foreach(var d in (IEnumerable<Department>)ViewBag.Departments){<option value="@d.DepartmentId">@d.DepartmentName</option>}</select></div>
<div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/></div><div class="form-group"><label asp-for="ContactInfo">Contact</label><input asp-for="ContactInfo" class="form-control" maxlength="10" inputmode="numeric" pattern="[0-9]{10}"/></div><div class="form-group"><label asp-for="BasicSalary"></label><input asp-for="BasicSalary" class="form-control"/></div><div class="form-group"><label asp-for="DateOfJoining">Date of Joining</label><input asp-for="DateOfJoining" type="date" class="form-control"/></div></div><button type="submit" class="btn btn-primary">Submit for Admin Approval</button></form></div></div>
