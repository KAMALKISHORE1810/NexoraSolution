@model OfficerCreateViewModel
@using NexoraEmployeePayroll.Enums
@{ ViewData["Title"]="Add Manager / HR / Payroll Officer"; var departments=ViewBag.Departments as IEnumerable<Department> ?? Array.Empty<Department>(); }
<div class="card"><div class="card-header"><h3>Create Staff Account</h3><p class="muted">Username and temporary password are automatic. Password = first four letters of name + DOB (DDMMYYYY). A department can have only one active manager.</p></div><div class="card-body"><form asp-action="CreateOfficer" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid">
<div class="form-group"><label asp-for="Name">Full Name</label><input asp-for="Name" class="form-control"/></div><div class="form-group"><label asp-for="DateOfBirth">Date of Birth</label><input asp-for="DateOfBirth" type="date" class="form-control"/></div><div class="form-group"><label asp-for="Role">Role</label><select asp-for="Role" class="form-control"><option value="@((int)UserRole.Manager)">Manager</option><option value="@((int)UserRole.HROfficer)">HR Officer</option><option value="@((int)UserRole.PayrollOfficer)">Payroll Officer</option></select></div><div class="form-group"><label asp-for="Designation">Designation</label><select asp-for="Designation" class="form-control"><option value="">-- Select Designation --</option>@foreach(var d in (IEnumerable<string>)ViewBag.Designations){<option value="@d">@d</option>}</select></div><div class="form-group"><label asp-for="DepartmentId">Department</label><select asp-for="DepartmentId" class="form-control">@foreach(var d in departments){<option value="@d.DepartmentId">@d.DepartmentName</option>}</select></div><div class="form-group"><label asp-for="Email">Email</label><input asp-for="Email" class="form-control"/></div><div class="form-group"><label asp-for="BasicSalary">Basic Salary</label><input asp-for="BasicSalary" type="number" min="1" step="0.01" class="form-control"/></div><div class="form-group"><label asp-for="ContactInfo">Contact</label><input asp-for="ContactInfo" class="form-control" maxlength="10" inputmode="numeric" pattern="[0-9]{10}"/></div></div><button class="btn btn-primary">Create Account & Generate Login</button></form></div></div>
