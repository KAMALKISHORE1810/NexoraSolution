@model DashboardViewModel
@using NexoraEmployeePayroll.Enums
@{ ViewData["Title"] = $"{Model.DisplayName} — Dashboard"; var totalRatings = Math.Max(Model.TotalRatings, 1); var p1=Model.RatingOneTwo*100.0/totalRatings; var p2=Model.RatingTwoThree*100.0/totalRatings; var p3=Model.RatingThreeFour*100.0/totalRatings; var a2=p1; var a3=p1+p2; var a4=p1+p2+p3; }
<div class="dashboard-intro"><div><h1>@Model.DisplayName</h1><p>@Model.Role dashboard</p></div></div>
@if(Model.Role==UserRole.Admin){<div class="metrics-grid"><div class="metric-card"><div>Total Active Workforce</div><strong>@Model.TotalEmployees</strong></div><div class="metric-card"><div>Average Attendance</div><strong>@Model.AverageAttendance.ToString("0.##")%</strong></div><div class="metric-card"><div>Monthly Payroll Disbursed</div><strong>₹@Model.MonthlyPayroll.ToString("N0")</strong></div><div class="metric-card"><div>Monthly Payroll Budget</div><strong>₹@Model.MonthlyPayrollBudget.ToString("N0")</strong><small>Current active workforce salary total</small></div><div class="metric-card"><div>Pending Approvals</div><strong>@Model.PendingApprovals</strong><small>Staff leave awaiting Admin decision</small></div><div class="metric-card"><div>Pending Employee Onboarding</div><strong>@Model.PendingEmployeeOnboarding</strong><small>HR requests awaiting Admin approval</small></div><div class="metric-card"><div>Pending Offboarding</div><strong>@Model.PendingOffboarding</strong><small>Manager, HR and Payroll requests awaiting Admin approval</small></div></div><div class="card"><div class="card-body"><a class="btn btn-primary" asp-controller="Employee" asp-action="OnboardingRequests">Review Employee Onboarding</a> <a class="btn btn-secondary" asp-controller="Employee" asp-action="OffboardingRequests">Review Offboarding</a> <a class="btn btn-secondary" asp-controller="Leave" asp-action="Index">Review Staff Leave</a></div></div>}
else if(Model.Role==UserRole.HROfficer){<div class="metrics-grid"><div class="metric-card"><div>Active Employees</div><strong>@Model.TotalEmployees</strong></div><div class="metric-card"><div>Average Attendance</div><strong>@Model.AverageAttendance.ToString("0.##")%</strong></div><div class="metric-card"><div>Pending Onboarding</div><strong>@Model.PendingEmployeeOnboarding</strong><small>Waiting for Admin approval</small></div><div class="metric-card"><div>Pending Offboarding</div><strong>@Model.PendingOffboarding</strong><small>Employee requests waiting for HR approval</small></div><div class="metric-card"><div>My Leave Requests</div><strong>@Model.MyPendingLeaves</strong><small>Waiting for Admin approval</small></div></div><div class="card"><div class="card-body"><a class="btn btn-primary btn-sm" asp-controller="Employee" asp-action="Create">Submit New Employee</a> <a class="btn btn-secondary btn-sm" asp-controller="Employee" asp-action="OffboardingRequests">Review Offboarding</a> <a class="btn btn-secondary btn-sm" asp-controller="Leave" asp-action="Index">View My Leave Status</a></div></div>}
else if(Model.Role==UserRole.PayrollOfficer){<div class="metrics-grid"><div class="metric-card"><div>Employees</div><strong>@Model.TotalEmployees</strong></div><div class="metric-card"><div>Pending Payroll</div><strong>@Model.PendingPayroll</strong><small>Current month unpaid payroll</small></div><div class="metric-card"><div>Monthly Payroll Budget</div><strong>₹@Model.MonthlyPayrollBudget.ToString("N0")</strong><small>Current active workforce salary total</small></div><div class="metric-card"><div>Employees on Leave</div><strong>@Model.EmployeesOnLeave</strong><small>Approved leave today</small></div><div class="metric-card"><div>My Leave Status</div><strong>@Model.MyPendingLeaves pending</strong><small>@Model.MyApprovedLeaves approved · @Model.MyRejectedLeaves rejected</small></div></div><div class="card"><div class="card-body"><a class="btn btn-primary btn-sm" asp-controller="Leave" asp-action="Index">View My Leave Status</a> <a class="btn btn-secondary btn-sm" asp-controller="Employee" asp-action="Index">Employee Directory & Payroll</a></div></div><div class="policy-note"><strong>Payroll policy:</strong> PF ₹1,800/month. Approved leave beyond the 2-day paid-leave criterion is Loss of Pay.</div>}
else if(Model.Role==UserRole.Manager){<div class="metrics-grid"><div class="metric-card"><div>Team Employees</div><strong>@Model.TotalEmployees</strong></div><div class="metric-card"><div>Leave Approvals</div><strong>@Model.PendingLeaveApprovals</strong><small>Team requests awaiting decision</small></div><div class="metric-card"><div>Employees on Leave</div><strong>@Model.EmployeesOnLeave</strong><small>Approved leave today</small></div></div><div class="card"><div class="card-header"><h3>Team Employee Rating Distribution</h3></div><div class="card-body"><div class="chart-container"><div class="pie-chart" style="background:conic-gradient(#ef4444 0 @a2%,#f59e0b @a2% @a3%,#3b82f6 @a3% @a4%,#10b981 @a4% 100%);"></div><div class="chart-legend"><div><span class="legend-color" style="background:#ef4444"></span> 0–1.9: @Model.RatingOneTwo</div><div><span class="legend-color" style="background:#f59e0b"></span> 2–2.9: @Model.RatingTwoThree</div><div><span class="legend-color" style="background:#3b82f6"></span> 3–3.9: @Model.RatingThreeFour</div><div><span class="legend-color" style="background:#10b981"></span> 4–5: @Model.RatingFourFive</div></div></div></div></div>}
else{<div class="metrics-grid"><div class="metric-card"><div>My Rating</div><strong>@(Model.MyAverageRating==0?"Not rated":Model.MyAverageRating.ToString("0.0")+" / 5")</strong></div><div class="metric-card"><div>My Salary</div><strong>₹@Model.MyCurrentSalary.ToString("N0")</strong></div><div class="metric-card"><div>Pending My Leave</div><strong>@Model.MyPendingLeaves</strong></div><div class="metric-card"><div>Approved Leave</div><strong>@Model.MyApprovedLeaves</strong></div></div><div class="card"><div class="card-header"><h3>My Profile & Latest Performance</h3></div><div class="card-body"><p>Your profile and manager ratings are available in My Profile. New ratings and updates are loaded from SQL Server.</p><a class="btn btn-primary" asp-controller="Employee" asp-action="Index">Open My Profile</a></div></div>}
