@model IEnumerable<Payroll>
@using NexoraEmployeePayroll.Enums
@{ ViewData["Title"] = User.IsInRole("Employee") ? "My Payroll & Payslips" : User.IsInRole("Manager") ? "Employee Payment Details" : "Salary & Disbursement"; }
<div class="card"><div class="card-header"><div><h3>@ViewData["Title"]</h3><p class="muted">Current payroll uses designation salary, PF ₹1,800 and Loss of Pay for excess approved leave / recorded absence.</p></div>@if(User.IsInRole("PayrollOfficer")){<a class="btn btn-secondary btn-sm" asp-controller="Employee" asp-action="Index">Employee Directory & Payroll</a>}</div><div class="card-body table-responsive"><table><thead><tr><th>Payroll</th><th>Employee</th><th>Designation</th><th>Month</th><th>Basic</th><th>Deductions</th><th>Net</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var p in Model){var paid=p.PaymentStatus==PaymentStatus.Paid;<tr><td>PAY-@p.PayrollId</td><td>@p.Employee?.Name</td><td>@p.Employee?.Designation</td><td>@p.Month</td><td>₹@p.BasicSalary.ToString("N0")</td><td>₹@p.Deductions.ToString("N0")</td><td><strong>₹@p.NetSalary.ToString("N0")</strong></td><td><span class="badge @(paid?"badge-paid":"badge-pending")">@(paid?"PAID":"PENDING")</span></td><td><div class="payroll-actions">@if(User.IsInRole("PayrollOfficer")){<a class="btn btn-primary btn-sm" asp-action="Details" asp-route-employeeId="@p.EmployeeId">View Salary Details</a> @if(!paid){<form asp-action="Pay" method="post" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.PayrollId"/><button class="btn btn-success btn-sm">Pay Now</button></form>} else {<a class="btn btn-primary btn-sm" asp-action="Payslip" asp-route-id="@p.PayrollId">Payslip</a>}} else if(User.IsInRole("Employee") && paid){<a class="btn btn-primary btn-sm" asp-action="Payslip" asp-route-id="@p.PayrollId">Download Payslip</a>} else {<span class="muted">View only</span>}</div></td></tr>}</tbody></table></div></div>
@if(User.IsInRole("PayrollOfficer")){<div class="card"><div class="card-header"><h3>Salary Disbursement Rule</h3></div><div class="card-body"><p>Open an employee's salary details to see required working days, recorded attendance, approved leave, paid leave, LOP days, PF and final net salary before paying.</p></div></div>}
