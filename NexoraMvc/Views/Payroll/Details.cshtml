@model PayrollEmployeeDetailViewModel
@{ViewData["Title"]=$"Salary Details — {Model.Employee.Name}";}
<div class="card"><div class="card-header"><h3>@Model.Employee.Name — @Model.Month</h3><p class="muted">Designation: @Model.Employee.Designation · Department: @Model.Employee.Department?.DepartmentName</p></div><div class="card-body"><div class="metrics-grid"><div class="metric-card"><div>Required Working Days</div><strong>@Model.RequiredWorkingDays</strong></div><div class="metric-card"><div>Present Days</div><strong>@Model.RecordedPresentDays</strong></div><div class="metric-card"><div>Approved Leave</div><strong>@Model.ApprovedLeaveDays</strong></div><div class="metric-card"><div>LOP Days</div><strong>@Model.LopLeaveDays + @Model.UnrecordedWorkingDays</strong></div></div><table><tr><td>Basic Salary (designation)</td><td>₹@Model.BasicSalary.ToString("N2")</td></tr><tr><td>PF</td><td>₹@Model.PF.ToString("N2")</td></tr><tr><td>Loss of Pay</td><td>₹@Model.LOPDeduction.ToString("N2")</td></tr><tr><td>Total Deductions</td><td>₹@Model.TotalDeductions.ToString("N2")</td></tr><tr><td><strong>Net Salary</strong></td><td><strong>₹@Model.NetSalary.ToString("N2")</strong></td></tr></table><div style="margin-top:18px">@if(Model.Payroll == null){<a class="btn btn-success" asp-action="Process" asp-route-employeeId="@Model.Employee.EmployeeId">Process This Month</a>}else if(Model.Payroll.PaymentStatus == NexoraEmployeePayroll.Enums.PaymentStatus.Pending){<form asp-action="Pay" method="post" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Payroll.PayrollId"/><button class="btn btn-success">Pay Now</button></form>}else{<span class="badge badge-paid">PAID</span> <a class="btn btn-primary" asp-action="Payslip" asp-route-id="@Model.Payroll.PayrollId">Download Payslip</a>}</div></div></div>
